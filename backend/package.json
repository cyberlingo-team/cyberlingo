{
  "name": "cyberlingo-backend",
  "private": true,
  "version": "0.0.0",
  "description": "API REST de CyberLingo : Express 5, Prisma 7 et PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "postinstall": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
