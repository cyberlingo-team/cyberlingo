# Copier ce fichier en .env et le remplir (voir le README). .env n'est jamais commité.

# Adresse de la base PostgreSQL : postgresql://utilisateur:mot_de_passe@hôte:port/base
# Avec `npx prisma dev`, c'est l'adresse « TCP » qu'il affiche.
DATABASE_URL="postgresql://cyberlingo:mot_de_passe@localhost:5432/cyberlingo"

# Secret qui signe les jetons de session (64 caractères au hasard). Pour en tirer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Port de l'API (4000 par défaut : c'est là que le proxy de Vite l'attend).
PORT=4000
